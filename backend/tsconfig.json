{
    "compilerOptions": {
        "rootDir": "./",
        "outDir": "./dist",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "esnext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "sourceMap": true,
        "types": ["node"]
    },
    "include": ["src/**/*", "prisma7.config.ts"]
}
