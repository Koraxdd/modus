generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  SAVED
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
}

model User {
  id                     String   @id @default(uuid())
  fullName               String
  email                  String   @unique
  passwordHash           String

  hasCompletedOnboarding Boolean @default(false)

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  jobs                   Job[]
}

model Job {
  id        String    @id @default(uuid())
  company   String
  role      String
  status    JobStatus @default(SAVED)
  color     String
  location  String?
  salary    String?
  jobUrl    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}