generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String   @id @default(uuid())
  fullName               String
  email                  String   @unique
  passwordHash           String

  hasCompletedOnboarding Boolean @default(false)

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}